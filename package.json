{
  "name": "playalong-animation-catalog",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PlayAlong TV catalog \u2014 animations, demos, screens and components, wired to the design tokens",
  "scripts": {
    "dev": "npm run tokens:build && vite",
    "build": "npm run tokens:build && tsc && vite build",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "tokens:build": "node scripts/tokens-to-css.mjs",
    "external:sync": "node scripts/sync-external.mjs && npm run tokens:build",
    "demo:tv-game-poc": "node scripts/build-demo-tv-game-poc.mjs"
  },
  "devDependencies": {
    "gh-pages": "^6.1.1",
    "typescript": "^5.4.0",
    "vite": "^5.2.0"
  }
}
